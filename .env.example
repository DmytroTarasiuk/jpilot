# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (create separate development and production instances)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Neon Postgres pooled connection string
DATABASE_URL=

# Private Cloudflare R2 bucket. Use an EU-jurisdiction endpoint when selected.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Optional Cloudmersive Virus Scan API. Disabled by default for prelaunch.
CV_MALWARE_SCAN_ENABLED=false
# Required only when CV_MALWARE_SCAN_ENABLED=true. Keep it server-only and store it as a Secret.
CLOUDMERSIVE_API_KEY=

# Dispatcher authentication; generate a high-entropy value in the deployment platform.
CRON_SECRET=

# Optional Phase 4 email summaries. In-app notifications work without these.
# Use a sending-only key and a verified sender/domain.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=JobPilot <notifications@example.com>

# Optional support diagnostics API. Generate a high-entropy server-only secret.
SUPPORT_ACCESS_SECRET=
