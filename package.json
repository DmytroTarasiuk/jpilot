{
  "name": "jobpilot-v2",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "pnpm build:agent && pnpm build:web",
    "build:agent": "eve build",
    "build:web": "cd apps/web && next build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "dev:web": "cd apps/web && next dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "eval": "eve eval",
    "start": "eve start",
    "restore:verify": "node scripts/verify-restore.mjs",
    "security:dependencies": "pnpm audit --prod --audit-level high",
    "security:scan": "pnpm security:secrets && pnpm security:dependencies",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "test": "vitest run",
    "typecheck": "pnpm typecheck:agent && pnpm typecheck:web",
    "typecheck:agent": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@clerk/backend": "^3.26.2",
    "@clerk/nextjs": "^7.9.20",
    "@js-temporal/polyfill": "^0.5.1",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shadcn/react": "0.3.1",
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@types/yauzl": "^3.4.0",
    "@vercel/connect": "2.5.2",
    "ai": "^7.0.137",
    "class-variance-authority": "0.7.1",
    "cloudmersive-virus-api-client": "1.4.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "^0.45.4",
    "eve": "^0.82.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "1.16.0",
    "mammoth": "^1.13.0",
    "motion": "12.40.0",
    "nanoid": "5.1.16",
    "next": "16.4.1",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "shiki": "3.23.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "unpdf": "^1.9.1",
    "use-stick-to-bottom": "1.1.4",
    "workflow": "^5.2.3",
    "yauzl": "^3.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/cloudmersive-virus-api-client": "1.1.4",
    "@types/node": "~26.6.5",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "microsandbox": "0.5.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
